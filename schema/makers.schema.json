{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://popboll.com/sdk/schema/makers.schema.json",
  "title": "Maker registry (makers.json)",
  "description": "The registry of maker codes in device serials, makers.json: format popboll.makers/1. A code must not be listed twice, which a schema cannot check.",
  "type": "object",
  "required": [
    "schema",
    "makers"
  ],
  "properties": {
    "schema": {
      "const": "popboll.makers/1"
    },
    "updated": {
      "type": "string"
    },
    "about": {
      "type": "string"
    },
    "makers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/maker"
      }
    }
  },
  "$defs": {
    "maker": {
      "type": "object",
      "required": [
        "code",
        "name",
        "kind",
        "registered",
        "contact",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "device-identity.schema.json#/$defs/maker_code"
        },
        "name": {
          "type": "string",
          "pattern": "[^ \\t\\r\\n]"
        },
        "kind": {
          "description": "Only first-party and third-party codes are assigned to devices.",
          "enum": [
            "first-party",
            "third-party",
            "reserved"
          ]
        },
        "registered": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "contact": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "third-party"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "description": "A third-party code is letters only.",
            "pattern": "^[A-Z]{3,6}$"
          }
        }
      }
    }
  }
}
