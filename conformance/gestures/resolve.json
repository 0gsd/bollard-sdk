  ],
  "bad_keymaps": [
    {"about": "version 1: meanings that do not say what they are", "gesture": "tap1", "prompt": "abc", "keymap": {"v": 1, "prompt": {"tap1": {"abc": "A"}}, "idle": {}, "always": {}}},
    {"about": "version 2 in name, a version 1 meaning inside", "gesture": "tap1", "prompt": "abc", "keymap": {"v": 2, "prompt": {"tap1": {"abc": "A"}}, "idle": {}, "always": {}}}
