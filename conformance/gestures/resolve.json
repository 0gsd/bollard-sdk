{
  "version": 2,
  "about": "Behaviour vectors for the keymap resolver (python: bollardeck.device.keymap.resolve), keymap version 2. Each group gives a keymap and cases: a gesture, the kind of prompt showing (null: none), and the expected answer. \"source\" is always, prompt, pocket, idle or null; a null source means the keymap does not claim the gesture. \"kind\" is choice (answer the prompt with \"value\"), do (\"value\" is a verb's name) or null. A prompt source with a null kind means the prompt takes the gesture and nothing happens. A case may name a device \"context\" (\"pocket\"; absent or null: none). The first group's keymap is the platform's (constants KEYMAP); the second is made up to exercise the precedence rules, and deliberately names gestures in more than one map; the third is the platform's keymap in the pocket context. \"bad_contexts\" are contexts the resolver must refuse. \"errors\" are gesture names the resolver must refuse; \"bad_keymaps\" are keymaps it must refuse to read for any gesture.",
  "groups": [
    {"name": "platform", "about": "The platform keymap, every gesture in every state, plus a kind of prompt it does not know.",
     "keymap": {"v": 2, "prompt": {"tap1": {"abc": {"choice": "A"}, "spectrum": {"choice": -1}, "game": {"do": "raw"}}, "tap2": {"abc": {"choice": "B"}, "spectrum": {"choice": 0}, "game": {"do": "raw"}}, "tap3": {"abc": {"choice": "C"}, "spectrum": {"choice": 1}, "game": {"do": "raw"}}, "tap1x3": {"abc": {"choice": "A"}, "spectrum": {"choice": -2}, "game": {"do": "raw"}}, "tap3x3": {"abc": {"choice": "C"}, "spectrum": {"choice": 2}, "game": {"do": "raw"}}, "hold1": {"abc": {"do": "replay"}, "spectrum": {"do": "replay"}, "game": null}, "hold2": {"abc": {"do": "pass"}, "spectrum": {"do": "pass"}, "game": {"do": "forfeit"}}}, "idle": {"tap1": "skip_to_frontier", "tap1x3": "leave_us_alone"}, "always": {"hold3": "power"}, "pocket": {"tap1": "play_pause", "hold1": "stop", "tap1x2": "volume_down", "tap2": "whats_on", "tap2x2": "prev", "hold2": "share", "tap3": "next", "tap3x2": "volume_up"}},
     "cases": [
       {"gesture": "tap1", "prompt": null, "expect": {"source": "idle", "kind": "do", "value": "skip_to_frontier"}},
       {"gesture": "tap1", "prompt": "abc", "expect": {"source": "prompt", "kind": "choice", "value": "A"}},
       {"gesture": "tap1", "prompt": "spectrum", "expect": {"source": "prompt", "kind": "choice", "value": -1}},
       {"gesture": "tap1", "prompt": "game", "expect": {"source": "prompt", "kind": "do", "value": "raw"}},
       {"gesture": "tap1", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2", "prompt": "abc", "expect": {"source": "prompt", "kind": "choice", "value": "B"}},
       {"gesture": "tap2", "prompt": "spectrum", "expect": {"source": "prompt", "kind": "choice", "value": 0}},
       {"gesture": "tap2", "prompt": "game", "expect": {"source": "prompt", "kind": "do", "value": "raw"}},
       {"gesture": "tap2", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3", "prompt": "abc", "expect": {"source": "prompt", "kind": "choice", "value": "C"}},
       {"gesture": "tap3", "prompt": "spectrum", "expect": {"source": "prompt", "kind": "choice", "value": 1}},
       {"gesture": "tap3", "prompt": "game", "expect": {"source": "prompt", "kind": "do", "value": "raw"}},
       {"gesture": "tap3", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap1x2", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap1x2", "prompt": "abc", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap1x2", "prompt": "spectrum", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap1x2", "prompt": "game", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap1x2", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x2", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x2", "prompt": "abc", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x2", "prompt": "spectrum", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x2", "prompt": "game", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x2", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x2", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x2", "prompt": "abc", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x2", "prompt": "spectrum", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x2", "prompt": "game", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x2", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap1x3", "prompt": null, "expect": {"source": "idle", "kind": "do", "value": "leave_us_alone"}},
       {"gesture": "tap1x3", "prompt": "abc", "expect": {"source": "prompt", "kind": "choice", "value": "A"}},
       {"gesture": "tap1x3", "prompt": "spectrum", "expect": {"source": "prompt", "kind": "choice", "value": -2}},
       {"gesture": "tap1x3", "prompt": "game", "expect": {"source": "prompt", "kind": "do", "value": "raw"}},
