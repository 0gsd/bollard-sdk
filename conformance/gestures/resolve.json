       {"gesture": "tap2x3", "prompt": "abc", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x3", "prompt": "spectrum", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x3", "prompt": "game", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x3", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x3", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x3", "prompt": "abc", "expect": {"source": "prompt", "kind": "choice", "value": "C"}},
       {"gesture": "tap3x3", "prompt": "spectrum", "expect": {"source": "prompt", "kind": "choice", "value": 2}},
       {"gesture": "tap3x3", "prompt": "game", "expect": {"source": "prompt", "kind": "do", "value": "raw"}},
       {"gesture": "tap3x3", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold1", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold1", "prompt": "abc", "expect": {"source": "prompt", "kind": "do", "value": "replay"}},
       {"gesture": "hold1", "prompt": "spectrum", "expect": {"source": "prompt", "kind": "do", "value": "replay"}},
       {"gesture": "hold1", "prompt": "game", "expect": {"source": "prompt", "kind": null, "value": null}},
       {"gesture": "hold1", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold2", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold2", "prompt": "abc", "expect": {"source": "prompt", "kind": "do", "value": "pass"}},
       {"gesture": "hold2", "prompt": "spectrum", "expect": {"source": "prompt", "kind": "do", "value": "pass"}},
       {"gesture": "hold2", "prompt": "game", "expect": {"source": "prompt", "kind": "do", "value": "forfeit"}},
       {"gesture": "hold2", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold3", "prompt": null, "expect": {"source": "always", "kind": "do", "value": "power"}},
       {"gesture": "hold3", "prompt": "abc", "expect": {"source": "always", "kind": "do", "value": "power"}},
       {"gesture": "hold3", "prompt": "spectrum", "expect": {"source": "always", "kind": "do", "value": "power"}},
       {"gesture": "hold3", "prompt": "game", "expect": {"source": "always", "kind": "do", "value": "power"}},
       {"gesture": "hold3", "prompt": "quiz", "expect": {"source": "always", "kind": "do", "value": "power"}}
     ]},
    {"name": "precedence", "about": "always wins over both other maps; idle is never consulted while a prompt is showing; an entry with no member for the kind does not claim the gesture; a choice is a choice whatever it is spelled like.",
     "keymap": {"v": 2, "prompt": {"tap1": {"quiz": {"choice": "first"}, "slider": {"choice": -1}}, "tap2": {"quiz": {"choice": "replay"}}, "hold1": {"quiz": null, "slider": {"do": "reset"}}, "hold3": {"quiz": {"do": "never"}}, "tap3": {"slider": {"choice": 0}}}, "idle": {"tap1": "wave", "tap2x2": "wink", "hold3": "never"}, "always": {"hold3": "sleep", "tap3x3": "panic"}},
     "cases": [
       {"gesture": "tap1", "prompt": null, "expect": {"source": "idle", "kind": "do", "value": "wave"}},
       {"gesture": "tap1", "prompt": "quiz", "expect": {"source": "prompt", "kind": "choice", "value": "first"}},
       {"gesture": "tap1", "prompt": "slider", "expect": {"source": "prompt", "kind": "choice", "value": -1}},
       {"gesture": "tap2", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2", "prompt": "quiz", "expect": {"source": "prompt", "kind": "choice", "value": "replay"}},
       {"gesture": "tap2", "prompt": "slider", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap2x2", "prompt": null, "expect": {"source": "idle", "kind": "do", "value": "wink"}},
       {"gesture": "tap2x2", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold1", "prompt": "quiz", "expect": {"source": "prompt", "kind": null, "value": null}},
       {"gesture": "hold1", "prompt": "slider", "expect": {"source": "prompt", "kind": "do", "value": "reset"}},
       {"gesture": "hold1", "prompt": null, "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold3", "prompt": null, "expect": {"source": "always", "kind": "do", "value": "sleep"}},
       {"gesture": "hold3", "prompt": "quiz", "expect": {"source": "always", "kind": "do", "value": "sleep"}},
       {"gesture": "tap3x3", "prompt": "slider", "expect": {"source": "always", "kind": "do", "value": "panic"}},
       {"gesture": "tap3x3", "prompt": null, "expect": {"source": "always", "kind": "do", "value": "panic"}},
       {"gesture": "tap3", "prompt": "quiz", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3", "prompt": "slider", "expect": {"source": "prompt", "kind": "choice", "value": 0}}
     ]},
    {"name": "pocket", "about": "The platform keymap in the pocket context (a cart with no dock): the pocket map answers before idle when no prompt is showing; always still wins; a showing prompt still wins over the pocket map; a gesture the pocket map does not name falls through to idle.",
     "keymap": {"v": 2, "prompt": {"tap1": {"abc": {"choice": "A"}, "spectrum": {"choice": -1}, "game": {"do": "raw"}}, "tap2": {"abc": {"choice": "B"}, "spectrum": {"choice": 0}, "game": {"do": "raw"}}, "tap3": {"abc": {"choice": "C"}, "spectrum": {"choice": 1}, "game": {"do": "raw"}}, "tap1x3": {"abc": {"choice": "A"}, "spectrum": {"choice": -2}, "game": {"do": "raw"}}, "tap3x3": {"abc": {"choice": "C"}, "spectrum": {"choice": 2}, "game": {"do": "raw"}}, "hold1": {"abc": {"do": "replay"}, "spectrum": {"do": "replay"}, "game": null}, "hold2": {"abc": {"do": "pass"}, "spectrum": {"do": "pass"}, "game": {"do": "forfeit"}}}, "idle": {"tap1": "skip_to_frontier", "tap1x3": "leave_us_alone"}, "always": {"hold3": "power"}, "pocket": {"tap1": "play_pause", "hold1": "stop", "tap1x2": "volume_down", "tap2": "whats_on", "tap2x2": "prev", "hold2": "share", "tap3": "next", "tap3x2": "volume_up"}},
     "cases": [
       {"gesture": "tap1", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "play_pause"}},
       {"gesture": "tap2", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "whats_on"}},
       {"gesture": "tap3", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "next"}},
       {"gesture": "tap1x2", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "volume_down"}},
       {"gesture": "tap2x2", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "prev"}},
       {"gesture": "tap3x2", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "volume_up"}},
       {"gesture": "tap1x3", "prompt": null, "context": "pocket", "expect": {"source": "idle", "kind": "do", "value": "leave_us_alone"}},
       {"gesture": "tap2x3", "prompt": null, "context": "pocket", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "tap3x3", "prompt": null, "context": "pocket", "expect": {"source": null, "kind": null, "value": null}},
       {"gesture": "hold1", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "stop"}},
       {"gesture": "hold2", "prompt": null, "context": "pocket", "expect": {"source": "pocket", "kind": "do", "value": "share"}},
       {"gesture": "hold3", "prompt": null, "context": "pocket", "expect": {"source": "always", "kind": "do", "value": "power"}},
       {"gesture": "tap1", "prompt": "abc", "context": "pocket", "expect": {"source": "prompt", "kind": "choice", "value": "A"}},
       {"gesture": "tap2", "prompt": "spectrum", "context": "pocket", "expect": {"source": "prompt", "kind": "choice", "value": 0}},
       {"gesture": "hold1", "prompt": "game", "context": "pocket", "expect": {"source": "prompt", "kind": null, "value": null}},
       {"gesture": "hold3", "prompt": "abc", "context": "pocket", "expect": {"source": "always", "kind": "do", "value": "power"}},
       {"gesture": "tap1x2", "prompt": "abc", "context": "pocket", "expect": {"source": null, "kind": null, "value": null}}
     ]}
  ],
  "errors": [
    {"gesture": "tap4", "about": "not a gesture name: the resolver must refuse it"},
    {"gesture": "tap1x4", "about": "a chain is 2 or 3 taps"},
