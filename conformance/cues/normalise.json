{
  "version": 2,
  "about": "Behaviour vectors for cue lists (python: bollardeck.device.cues; js: bollardeck.cues). \"normalise\": an input (any JSON); \"valid\", whether the input is itself a valid cue list (it fits schema/cue.schema.json and names no button twice), which is what problems() answers and what at() and compile() require; \"one_per_button\", on inputs that fit the schema and name a button twice, the JSON pointers problems() must report under the keyword one-per-button; \"output\", the list normalise returns, which is always valid; \"repairs\", what repairs() reports (the place in the input, or null for the list itself; the kind; whether the cue was dropped or kept with a repair); the text line for the result, and its wire form. \"from_wire\": a bollardeck cues message's list and the cue list it stands for. \"lines\": see its own about. Every cue list is made up.",
  "normalise": [
    {"name": "empty", "input": [], "output": [], "line": "1:off:- 2:off:- 3:off:-", "wire": [], "repairs": [], "valid": true},
    {"name": "already-normal", "input": [{"button": 1, "state": "on", "role": "a"}, {"button": 3, "state": "pulse", "role": "go"}], "output": [{"button": 1, "state": "on", "role": "a"}, {"button": 3, "state": "pulse", "role": "go"}], "line": "1:on:a 2:off:- 3:pulse:go", "wire": [{"btn": "inner", "state": "on", "role": "a"}, {"btn": "outer", "state": "pulse", "role": "go"}], "repairs": [], "valid": true},
    {"name": "sorted-by-button", "input": [{"button": 3, "state": "chase", "role": "c"}, {"button": 1, "state": "on", "role": null}], "output": [{"button": 1, "state": "on", "role": null}, {"button": 3, "state": "chase", "role": "c"}], "line": "1:on:- 2:off:- 3:chase:c", "wire": [{"btn": "inner", "state": "on", "role": null}, {"btn": "outer", "state": "chase", "role": "c"}], "repairs": [], "valid": true},
    {"name": "missing-role-is-none", "input": [{"button": 2, "state": "on"}], "output": [{"button": 2, "state": "on", "role": null}], "line": "1:off:- 2:on:- 3:off:-", "wire": [{"btn": "middle", "state": "on", "role": null}], "repairs": [], "valid": false},
    {"name": "extra-members-are-left-out", "input": [{"button": 2, "state": "on", "role": "b", "colour": "red"}], "output": [{"button": 2, "state": "on", "role": "b"}], "line": "1:off:- 2:on:b 3:off:-", "wire": [{"btn": "middle", "state": "on", "role": "b"}], "repairs": [], "valid": false},
    {"name": "explicit-off", "input": [{"button": 1, "state": "off", "role": null}], "output": [{"button": 1, "state": "off", "role": null}], "line": "1:off:- 2:off:- 3:off:-", "wire": [{"btn": "inner", "state": "off", "role": null}], "repairs": [], "valid": true},
    {"name": "last-cue-for-a-button-wins", "input": [{"button": 1, "state": "on", "role": "a"}, {"button": 1, "state": "pulse", "role": "b"}], "output": [{"button": 1, "state": "pulse", "role": "b"}], "line": "1:pulse:b 2:off:- 3:off:-", "wire": [{"btn": "inner", "state": "pulse", "role": "b"}], "repairs": [{"index": 1, "kind": "duplicate", "dropped": false}], "valid": false, "one_per_button": ["/1/button"]},
    {"name": "three-cues-for-one-button", "input": [{"button": 2, "state": "on", "role": "a"}, {"button": 2, "state": "pulse", "role": "b"}, {"button": 2, "state": "chase", "role": "c"}], "output": [{"button": 2, "state": "chase", "role": "c"}], "line": "1:off:- 2:chase:c 3:off:-", "wire": [{"btn": "middle", "state": "chase", "role": "c"}], "repairs": [{"index": 1, "kind": "duplicate", "dropped": false}, {"index": 2, "kind": "duplicate", "dropped": false}], "valid": false, "one_per_button": ["/1/button", "/2/button"]},
    {"name": "two-identical-cues-are-still-two", "input": [{"button": 3, "state": "on", "role": "go"}, {"button": 3, "state": "on", "role": "go"}], "output": [{"button": 3, "state": "on", "role": "go"}], "line": "1:off:- 2:off:- 3:on:go", "wire": [{"btn": "outer", "state": "on", "role": "go"}], "repairs": [{"index": 1, "kind": "duplicate", "dropped": false}], "valid": false, "one_per_button": ["/1/button"]},
    {"name": "unknown-role-becomes-none", "input": [{"button": 2, "state": "on", "role": "purple"}], "output": [{"button": 2, "state": "on", "role": null}], "line": "1:off:- 2:on:- 3:off:-", "wire": [{"btn": "middle", "state": "on", "role": null}], "repairs": [{"index": 0, "kind": "role", "dropped": false}], "valid": false},
    {"name": "role-on-an-off-cue-becomes-none", "input": [{"button": 2, "state": "off", "role": "go"}], "output": [{"button": 2, "state": "off", "role": null}], "line": "1:off:- 2:off:- 3:off:-", "wire": [{"btn": "middle", "state": "off", "role": null}], "repairs": [{"index": 0, "kind": "role", "dropped": false}], "valid": false},
    {"name": "bad-button-is-dropped", "input": [{"button": 4, "state": "on", "role": null}, {"button": 0, "state": "on", "role": null}, {"button": 2, "state": "on", "role": null}], "output": [{"button": 2, "state": "on", "role": null}], "line": "1:off:- 2:on:- 3:off:-", "wire": [{"btn": "middle", "state": "on", "role": null}], "repairs": [{"index": 0, "kind": "button", "dropped": true}, {"index": 1, "kind": "button", "dropped": true}], "valid": false},
    {"name": "button-as-a-string-is-dropped", "input": [{"button": "1", "state": "on", "role": null}], "output": [], "line": "1:off:- 2:off:- 3:off:-", "wire": [], "repairs": [{"index": 0, "kind": "button", "dropped": true}], "valid": false},
    {"name": "button-true-is-dropped", "input": [{"button": true, "state": "on", "role": null}], "output": [], "line": "1:off:- 2:off:- 3:off:-", "wire": [], "repairs": [{"index": 0, "kind": "button", "dropped": true}], "valid": false},
    {"name": "wire-form-is-not-a-cue", "input": [{"btn": "inner", "state": "on", "role": "a"}], "output": [], "line": "1:off:- 2:off:- 3:off:-", "wire": [], "repairs": [{"index": 0, "kind": "button", "dropped": true}], "valid": false},
    {"name": "bad-state-is-dropped", "input": [{"button": 1, "state": "blink", "role": null}, {"button": 2, "state": null, "role": null}, {"button": 3, "state": "on", "role": null}], "output": [{"button": 3, "state": "on", "role": null}], "line": "1:off:- 2:off:- 3:on:-", "wire": [{"btn": "outer", "state": "on", "role": null}], "repairs": [{"index": 0, "kind": "state", "dropped": true}, {"index": 1, "kind": "state", "dropped": true}], "valid": false},
    {"name": "not-an-object-is-dropped", "input": ["1:on:a", null, {"button": 1, "state": "on", "role": "live"}], "output": [{"button": 1, "state": "on", "role": "live"}], "line": "1:on:live 2:off:- 3:off:-", "wire": [{"btn": "inner", "state": "on", "role": "live"}], "repairs": [{"index": 0, "kind": "cue", "dropped": true}, {"index": 1, "kind": "cue", "dropped": true}], "valid": false},
    {"name": "not-a-list", "input": {"button": 1, "state": "on", "role": null}, "output": [], "line": "1:off:- 2:off:- 3:off:-", "wire": [], "repairs": [{"index": null, "kind": "list", "dropped": true}], "valid": false},
    {"name": "four-cues-keep-the-good-ones", "input": [{"button": 1, "state": "on", "role": null}, {"button": 2, "state": "on", "role": null}, {"button": 3, "state": "on", "role": null}, {"button": 4, "state": "on", "role": null}], "output": [{"button": 1, "state": "on", "role": null}, {"button": 2, "state": "on", "role": null}, {"button": 3, "state": "on", "role": null}], "line": "1:on:- 2:on:- 3:on:-", "wire": [{"btn": "inner", "state": "on", "role": null}, {"btn": "middle", "state": "on", "role": null}, {"btn": "outer", "state": "on", "role": null}], "repairs": [{"index": 3, "kind": "button", "dropped": true}], "valid": false}
  ],
  "from_wire": [
    {"name": "wire-to-cues", "wire": [{"btn": "outer", "state": "chase", "role": "c"}, {"btn": "inner", "state": "on", "role": null}], "output": [{"button": 1, "state": "on", "role": null}, {"button": 3, "state": "chase", "role": "c"}], "repairs": []},
    {"name": "unknown-btn-is-dropped", "wire": [{"btn": "centre", "state": "on", "role": null}, {"btn": "middle", "state": "on", "role": "b"}], "output": [{"button": 2, "state": "on", "role": "b"}], "repairs": [{"index": 0, "kind": "button", "dropped": true}]},
    {"name": "btn-as-a-number-is-dropped", "wire": [{"btn": 1, "state": "on", "role": null}], "output": [], "repairs": [{"index": 0, "kind": "button", "dropped": true}]},
    {"name": "a-device-form-cue-is-not-a-wire-cue", "wire": [{"button": 1, "state": "on", "role": null}], "output": [], "repairs": [{"index": 0, "kind": "button", "dropped": true}]},
    {"name": "empty-clears", "wire": [], "output": [], "repairs": []}
  ],
  "lines": {"about": "A sequence of cue lists set one after another, and the lines a line renderer writes: one line per change, nothing for a list that reads the same as the one before.",
    "sets": [
      [{"button": 2, "state": "pulse", "role": "go"}],
      [{"button": 2, "state": "pulse", "role": "go"}],
      [{"button": 2, "state": "on", "role": "go"}],
      [{"button": 1, "state": "on", "role": "a"}, {"button": 3, "state": "chase", "role": "c"}],
      [{"button": 3, "state": "chase", "role": "c"}, {"button": 1, "state": "on", "role": "a"}],
      [],
      [{"button": 1, "state": "off", "role": null}]
    ],
    "lines": ["1:off:- 2:pulse:go 3:off:-", "1:off:- 2:on:go 3:off:-", "1:on:a 2:off:- 3:chase:c", "1:off:- 2:off:- 3:off:-"]}
}
