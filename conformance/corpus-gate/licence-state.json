 "cases": [
  {
   "name": "no licence member allows nothing",
   "manifest": "no_licence_member",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "licence_missing"
   },
   "why": "A missing licence block is refused: a corpus with no stated licence is not assumed to be open."
  },
  {
   "name": "no licence member: every capability",
   "manifest": "no_licence_member",
   "capability": "stream_audio",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "licence_missing"
   }
  },
  {
   "name": "licence null allows nothing",
   "manifest": "licence_null",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "licence_missing"
   },
   "why": "A null licence block is a missing one. It is not scope full."
  },
  {
   "name": "no licence, still visible",
   "manifest": "no_licence_member",
   "capability": "see",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": true,
    "reason": "allowed"
   },
   "why": "see asks about visibility only, so a client can list the corpus and say why it cannot be used."
  },
  {
   "name": "alias alone is the licence",
   "manifest": "alias_only",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": true,
    "reason": "allowed"
   }
  },
  {
   "name": "alias alone is read as written",
   "manifest": "alias_only",
   "capability": "stream_audio",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "not_granted"
   }
  },
  {
   "name": "null licence does not hide the alias",
   "manifest": "null_and_alias",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": true,
    "reason": "allowed"
   },
   "why": "When licence is null the valid block under license is honoured."
  },
  {
   "name": "null licence, alias limits apply",
   "manifest": "null_and_alias",
   "capability": "export_morpus",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "not_granted"
   }
  },
  {
   "name": "both spellings, same block",
   "manifest": "both_same",
   "capability": "stream_audio",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": true,
    "reason": "allowed"
   }
  },
  {
   "name": "both spellings, different blocks",
   "manifest": "both_differ",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "licence_ambiguous"
   },
   "why": "Two different blocks: refused whole, even for a capability both would allow."
  },
  {
   "name": "a license that is a string is a note",
   "manifest": "alias_is_a_note",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "licence_missing"
   }
  },
  {
   "name": "a block plus a note",
   "manifest": "licence_and_note",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": true,
    "reason": "allowed"
   }
  },
  {
   "name": "unknown scope",
   "manifest": "unknown_scope",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "unknown_scope"
   }
  },
  {
   "name": "newer version",
   "manifest": "newer_version",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "newer_version"
   }
  },
  {
   "name": "invalid alias beside a valid licence",
   "manifest": "alias_invalid",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "manifest_invalid"
   },
   "why": "A block under license must be a valid licence even when licence is present."
  },
  {
   "name": "licence is a string",
   "manifest": "licence_a_string",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "manifest_invalid"
   }
  },
  {
   "name": "schema_version 2",
   "manifest": "schema_version_2",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "manifest_invalid"
   }
  },
  {
   "name": "id is not number and slug",
   "manifest": "id_does_not_match",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "manifest_invalid"
   },
   "why": "The schema cannot say this; the reader checks it."
  },
  {
   "name": "unknown visibility",
   "manifest": "visibility_unknown",
   "capability": "see",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "manifest_invalid"
   },
   "why": "An unknown setting refuses the manifest; it is not read as private or public."
  },
  {
   "name": "30 February",
   "manifest": "thirtieth_of_february",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "licence_invalid"
   },
   "why": "The schema's pattern accepts it; it is not a moment, so the block is closed."
  },
  {
   "name": "30 February, still visible",
   "manifest": "thirtieth_of_february",
   "capability": "see",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": true,
    "reason": "allowed"
   }
  },
  {
   "name": "hard limit broken in the block",
   "manifest": "hard_limit_broken",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "manifest_invalid"
   },
   "why": "An inconsistent block is not partly read."
  },
  {
   "name": "unknown scope and another fault",
   "manifest": "unknown_scope_and_more",
   "capability": "musicians_may_study",
   "clock": "2031-06-01T12:00:00Z",
   "expect": {
    "allowed": false,
    "reason": "manifest_invalid"
   },
   "why": "unknown_scope is reported only when it is the manifest's only fault."
  }
 ]
}
